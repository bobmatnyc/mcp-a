{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/discover.response.json",
  "title": "mcpa.discover Response",
  "type": "object",
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "schema_version": { "type": "string" },
          "schema_id": { "type": "string", "format": "uri" },
          "status": { "type": "string", "enum": ["active", "deprecated", "read_only"] },
          "freshness_seconds": { "type": "integer", "minimum": 0 },
          "scope_summary": { "type": "string" },
          "example_questions": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
          "query_guidance": { "type": "string", "maxLength": 4000 },
          "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
        },
        "required": ["domain_id", "name", "description", "schema_version", "schema_id", "status", "freshness_seconds", "scope_summary"],
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": "string" },
    "total_count": { "type": "integer", "minimum": 0 },
    "as_of": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["domains", "as_of"],
  "additionalProperties": false
}
