{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/follow_up.request.json",
  "title": "mcpa.follow_up Request",
  "type": "object",
  "properties": {
    "answer_id": { "type": "string" },
    "refinement": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "drill_id": { "type": "string" },
    "response_target": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ResponseTarget" },
    "options": {
      "type": "object",
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "consistency": { "type": "string", "enum": ["best_effort", "snapshot", "source_native"] }
      },
      "additionalProperties": false
    },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["answer_id"],
  "oneOf": [{ "required": ["refinement"] }, { "required": ["drill_id"] }],
  "additionalProperties": false
}
