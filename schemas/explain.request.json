{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/explain.request.json",
  "title": "mcpa.explain Request",
  "type": "object",
  "properties": {
    "answer_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "include_plan": { "type": "boolean", "default": true },
    "include_source_statuses": { "type": "boolean", "default": true },
    "feedback": {
      "type": "object",
      "properties": {
        "helpful": { "type": "boolean" },
        "comments": { "type": "string", "maxLength": 4000 },
        "expected_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "delete_prior_feedback": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "oneOf": [
    { "required": ["answer_id"], "not": { "required": ["execution_id"] } },
    { "required": ["execution_id"], "not": { "required": ["answer_id"] } }
  ],
  "additionalProperties": false
}
