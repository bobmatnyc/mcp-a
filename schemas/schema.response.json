{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/schema.response.json",
  "title": "mcpa.schema Response",
  "type": "object",
  "properties": {
    "domain_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "schema_id": { "type": "string", "format": "uri" },
    "target": { "type": "string", "enum": ["domain", "query", "action"] },
    "path": { "type": "string" },
    "truncated": { "type": "boolean" },
    "next_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "ontology": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "semantic_id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "semantic_id": { "type": "string" },
                    "name": { "type": "string" },
                    "data_type": { "type": "string", "enum": ["string", "boolean", "integer", "number", "decimal", "date", "date-time", "duration", "enum", "reference", "object", "array"] },
                    "format": { "type": "string" },
                    "unit": { "type": "string" },
                    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                    "precision": { "type": "integer", "minimum": 1 },
                    "scale": { "type": "integer", "minimum": 0 },
                    "timezone": { "type": "string" },
                    "nullable": { "type": "boolean" },
                    "role": { "type": "string", "enum": ["attribute", "dimension", "measure", "identifier"] },
                    "allowed_aggregations": { "type": "array", "items": { "type": "string", "enum": ["count", "count_distinct", "sum", "avg", "min", "max"] }, "uniqueItems": true },
                    "enum_values": { "type": "array", "items": true }
                  },
                  "required": ["semantic_id", "name", "data_type", "nullable", "role"],
                  "additionalProperties": false
                }
              },
              "relationships": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "semantic_id": { "type": "string" },
                    "name": { "type": "string" },
                    "target_entity": { "type": "string" },
                    "cardinality": { "type": "string", "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"] }
                  },
                  "required": ["semantic_id", "name", "target_entity", "cardinality"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["semantic_id", "name", "fields"],
            "additionalProperties": false
          }
        }
      },
      "required": ["entities"],
      "additionalProperties": false
    },
    "query_capabilities": {
      "type": "object",
      "properties": {
        "query_plan_schema": { "type": "object" },
        "max_limit": { "type": "integer", "minimum": 1 },
        "supported_consistency": { "type": "array", "items": { "type": "string", "enum": ["best_effort", "snapshot", "source_native"] }, "uniqueItems": true },
        "supports_filtering": { "type": "boolean" },
        "supports_grouping": { "type": "boolean" },
        "supports_ordering": { "type": "boolean" }
      },
      "required": ["query_plan_schema", "max_limit", "supported_consistency", "supports_filtering", "supports_grouping", "supports_ordering"],
      "additionalProperties": false
    },
    "operations": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/OperationSummary" } },
    "api_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface_id": { "type": "string" },
          "format": { "type": "string", "enum": ["openapi-3.1", "graphql-sdl", "sql-catalog", "other"] },
          "media_type": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "resource_uri": { "type": "string", "format": "uri" },
          "inline": { "type": ["string", "object"] }
        },
        "required": ["surface_id", "format", "media_type", "digest", "size"],
        "oneOf": [{ "required": ["resource_uri"] }, { "required": ["inline"] }],
        "additionalProperties": false
      }
    },
    "as_of": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["domain_id", "schema_version", "schema_id", "target", "truncated", "next_paths", "as_of"],
  "allOf": [
    {
      "if": { "properties": { "target": { "const": "domain" } }, "required": ["target"] },
      "then": {
        "required": ["ontology"],
        "not": { "anyOf": [{ "required": ["query_capabilities"] }, { "required": ["operations"] }] }
      }
    },
    {
      "if": { "properties": { "target": { "const": "query" } }, "required": ["target"] },
      "then": {
        "required": ["query_capabilities"],
        "not": { "anyOf": [{ "required": ["ontology"] }, { "required": ["operations"] }] }
      }
    },
    {
      "if": { "properties": { "target": { "const": "action" } }, "required": ["target"] },
      "then": {
        "required": ["operations"],
        "not": { "anyOf": [{ "required": ["ontology"] }, { "required": ["query_capabilities"] }] }
      }
    }
  ],
  "additionalProperties": false
}
