{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/query.request.json",
  "title": "mcpa.query Request",
  "type": "object",
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "query_plan": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/QueryPlan" },
    "response_target": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ResponseTarget" },
    "query_id": { "type": "string" },
    "inputs": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "options": {
      "type": "object",
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
        "max_result_bytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
        "language": { "type": "string" },
        "include_prose": { "type": "boolean", "default": true },
        "include_confidence": { "type": "boolean", "default": false },
        "consistency": { "type": "string", "enum": ["best_effort", "snapshot", "source_native"] }
      },
      "additionalProperties": false
    },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "oneOf": [
    {
      "title": "Natural-language query",
      "required": ["question"],
      "not": { "anyOf": [{ "required": ["query_plan"] }, { "required": ["query_id"] }, { "required": ["inputs"] }] }
    },
    {
      "title": "Structured query plan",
      "required": ["query_plan"],
      "not": { "anyOf": [{ "required": ["question"] }, { "required": ["query_id"] }, { "required": ["inputs"] }] }
    },
    {
      "title": "Input continuation",
      "required": ["query_id", "inputs"],
      "not": { "anyOf": [{ "required": ["question"] }, { "required": ["query_plan"] }, { "required": ["response_target"] }] }
    }
  ],
  "additionalProperties": false
}
