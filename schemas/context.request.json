{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/context.request.json",
  "title": "mcpa.context Request",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "enum": ["read", "set", "append", "clear"] },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "key": { "type": "string", "maxLength": 256 },
    "value": true,
    "expected_version": { "type": "integer", "minimum": 0 },
    "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["mode"],
  "oneOf": [
    {
      "properties": { "mode": { "const": "read" } },
      "not": { "anyOf": [{ "required": ["value"] }, { "required": ["expected_version"] }, { "required": ["ttl_seconds"] }] }
    },
    {
      "properties": { "mode": { "const": "set" } },
      "required": ["namespace", "key", "value"]
    },
    {
      "properties": { "mode": { "const": "append" } },
      "required": ["namespace", "key", "value"],
      "not": { "required": ["ttl_seconds"] }
    },
    {
      "properties": { "mode": { "const": "clear" } },
      "required": ["namespace"],
      "not": { "anyOf": [{ "required": ["value"] }, { "required": ["ttl_seconds"] }] }
    }
  ],
  "dependentRequired": {
    "key": ["namespace"]
  },
  "additionalProperties": false
}
