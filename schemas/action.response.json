{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/action.response.json",
  "title": "mcpa.action Response",
  "type": "object",
  "properties": {
    "execution_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "operation_version": { "type": "string" },
    "status": { "type": "string", "enum": ["input_required", "approval_required", "preview", "completed", "partially_completed", "failed", "cancelled"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "normalized_inputs": { "type": "object", "additionalProperties": true },
    "input_request": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/InputRequest" },
    "approval_request": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "message": { "type": "string" },
        "risk": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "expires_at": { "type": "string", "format": "date-time" },
        "reversible": { "type": "boolean" },
        "planned_effects": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" }, "minItems": 1 }
      },
      "required": ["request_id", "message", "risk", "reversible", "planned_effects"],
      "additionalProperties": false
    },
    "effects": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" }, "minItems": 1 },
    "result": true,
    "error": { "$ref": "https://mcp-a.dev/schemas/2.0/error.json" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "audit_id": { "type": "string" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["execution_id", "operation_id", "operation_version", "status", "attempt", "normalized_inputs", "created_at", "updated_at", "audit_id"],
  "oneOf": [
    {
      "properties": { "status": { "const": "input_required" } },
      "required": ["input_request"],
      "not": { "anyOf": [{ "required": ["approval_request"] }, { "required": ["effects"] }, { "required": ["result"] }, { "required": ["error"] }] }
    },
    {
      "properties": { "status": { "const": "approval_required" } },
      "required": ["approval_request"],
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["effects"] }, { "required": ["result"] }, { "required": ["error"] }] }
    },
    {
      "properties": {
        "status": { "const": "preview" },
        "effects": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" },
              { "properties": { "status": { "const": "planned" } } }
            ]
          },
          "minItems": 1
        }
      },
      "required": ["effects"],
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["approval_request"] }, { "required": ["result"] }, { "required": ["error"] }] }
    },
    {
      "properties": {
        "status": { "const": "completed" },
        "effects": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" },
              { "properties": { "status": { "enum": ["applied", "compensated"] } } }
            ]
          },
          "minItems": 1
        }
      },
      "required": ["effects", "result"],
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["approval_request"] }, { "required": ["error"] }] }
    },
    {
      "properties": {
        "status": { "const": "partially_completed" },
        "effects": {
          "type": "array",
          "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" },
          "minItems": 2,
          "allOf": [
            {
              "contains": {
                "properties": { "status": { "enum": ["applied", "compensated"] } },
                "required": ["status"]
              }
            },
            {
              "contains": {
                "properties": { "status": { "enum": ["failed", "compensation_failed"] } },
                "required": ["status"]
              }
            }
          ]
        }
      },
      "required": ["effects", "error"],
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["approval_request"] }] }
    },
    {
      "properties": { "status": { "const": "failed" } },
      "required": ["error"],
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["approval_request"] }, { "required": ["result"] }, { "required": ["effects"] }] }
    },
    {
      "properties": { "status": { "const": "cancelled" } },
      "not": { "anyOf": [{ "required": ["input_request"] }, { "required": ["approval_request"] }, { "required": ["result"] }, { "required": ["effects"] }, { "required": ["error"] }] }
    }
  ],
  "additionalProperties": false
}
