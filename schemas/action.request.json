{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/action.request.json",
  "title": "mcpa.action Request",
  "type": "object",
  "properties": {
    "operation_id": { "type": "string" },
    "operation_version": { "type": "string" },
    "request": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "inputs": { "type": "object", "additionalProperties": true },
    "execution_id": { "type": "string" },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 255 },
    "preview": { "type": "boolean", "default": false },
    "preconditions": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Precondition" } },
    "approval": { "type": "string", "enum": ["approve", "deny"] },
    "approval_request_id": { "type": "string" },
    "cancel": { "const": true },
    "options": {
      "type": "object",
      "properties": { "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 } },
      "additionalProperties": false
    },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "oneOf": [
    {
      "title": "Typed new action",
      "required": ["operation_id", "inputs"],
      "not": { "anyOf": [{ "required": ["request"] }, { "required": ["execution_id"] }, { "required": ["approval"] }, { "required": ["cancel"] }] }
    },
    {
      "title": "Natural-language action resolution",
      "required": ["request"],
      "not": { "anyOf": [{ "required": ["operation_id"] }, { "required": ["operation_version"] }, { "required": ["inputs"] }, { "required": ["execution_id"] }, { "required": ["approval"] }, { "required": ["cancel"] }, { "required": ["idempotency_key"] }] }
    },
    {
      "title": "Input continuation",
      "required": ["execution_id", "inputs"],
      "not": { "anyOf": [{ "required": ["operation_id"] }, { "required": ["operation_version"] }, { "required": ["request"] }, { "required": ["approval"] }, { "required": ["cancel"] }] }
    },
    {
      "title": "Approval continuation",
      "required": ["execution_id", "approval", "approval_request_id"],
      "not": { "anyOf": [{ "required": ["operation_id"] }, { "required": ["operation_version"] }, { "required": ["request"] }, { "required": ["inputs"] }, { "required": ["cancel"] }] }
    },
    {
      "title": "Cancellation continuation",
      "required": ["execution_id", "cancel"],
      "not": { "anyOf": [{ "required": ["operation_id"] }, { "required": ["operation_version"] }, { "required": ["request"] }, { "required": ["inputs"] }, { "required": ["approval"] }] }
    }
  ],
  "dependentRequired": { "approval": ["approval_request_id"], "approval_request_id": ["approval"] },
  "additionalProperties": false
}
