{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/schema.request.json",
  "title": "mcpa.schema Request",
  "type": "object",
  "properties": {
    "domain_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "enum": ["domain", "query", "action"], "default": "domain" },
    "operation_id": { "type": "string" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "depth": { "type": "integer", "minimum": 1, "maximum": 10, "default": 2 },
    "include_api_surfaces": { "type": "boolean", "default": false },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["domain_id"],
  "allOf": [
    {
      "if": { "required": ["operation_id"] },
      "then": { "properties": { "target": { "const": "action" } }, "required": ["target"] }
    }
  ],
  "additionalProperties": false
}
