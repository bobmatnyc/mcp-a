{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/explain.response.json",
  "title": "mcpa.explain Response",
  "type": "object",
  "properties": {
    "answer_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "safe_summary": { "type": "string" },
    "executed_query_plan": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/QueryPlan" },
    "routing": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Routing" },
    "source_statuses": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/SourceStatus" } },
    "conflicts": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Conflict" } },
    "action_trace": {
      "type": "object",
      "properties": {
        "operation_id": { "type": "string" },
        "operation_version": { "type": "string" },
        "normalized_inputs_digest": { "type": "string" },
        "policy_decision": { "type": "string", "enum": ["allowed", "denied", "approval_required"] },
        "approval_recorded": { "type": "boolean" },
        "preconditions_satisfied": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 1 },
        "effects": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ActionEffect" } }
      },
      "required": ["operation_id", "operation_version", "normalized_inputs_digest", "policy_decision", "approval_recorded", "preconditions_satisfied", "attempts", "effects"],
      "additionalProperties": false
    },
    "feedback_recorded": { "type": "boolean" },
    "feedback_expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["safe_summary", "created_at"],
  "oneOf": [
    { "required": ["answer_id", "routing", "source_statuses", "conflicts"], "not": { "anyOf": [{ "required": ["execution_id"] }, { "required": ["action_trace"] }] } },
    { "required": ["execution_id", "action_trace"], "not": { "anyOf": [{ "required": ["answer_id"] }, { "required": ["routing"] }, { "required": ["executed_query_plan"] }, { "required": ["source_statuses"] }, { "required": ["conflicts"] }] } }
  ],
  "dependentRequired": { "feedback_expires_at": ["feedback_recorded"] },
  "additionalProperties": false
}
