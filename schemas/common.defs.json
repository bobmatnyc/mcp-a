{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/common.defs.json",
  "title": "MCP-A 2.0 Common Definitions",
  "$defs": {
    "Extensions": {
      "type": "object",
      "description": "Namespaced extension values. Keys use reverse-DNS owner/name form.",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+/[A-Za-z0-9._-]+$" },
      "additionalProperties": true
    },
    "ComputedScope": {
      "type": "object",
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "scope_hash": { "type": "string", "minLength": 16 },
        "policy_version": { "type": "string" }
      },
      "required": ["summary"],
      "additionalProperties": false
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "source_system": { "type": "string", "minLength": 1 },
        "domain_id": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "stale", "timeout", "unavailable", "denied", "invalid", "skipped"] },
        "required": { "type": "boolean", "default": true },
        "as_of": { "type": "string", "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "safe_detail": { "type": "string" },
        "error_code": { "type": "string" }
      },
      "required": ["source_system", "status", "required"],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "structured_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "required": ["claim_id"],
      "anyOf": [{ "required": ["text"] }, { "required": ["structured_paths"] }],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "citation_id": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "source_system": { "type": "string", "minLength": 1 },
        "domain_id": { "type": "string" },
        "entity_type": { "type": "string" },
        "entity_id": { "type": "string" },
        "record_version": { "type": "string" },
        "source_uri": { "type": "string", "format": "uri" },
        "snippet": { "type": "string", "maxLength": 4000 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "as_of": { "type": "string", "format": "date-time" }
      },
      "required": ["citation_id", "claim_ids", "source_system", "retrieved_at"],
      "additionalProperties": false
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "conflict_id": { "type": "string" },
        "claim_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string" },
        "resolution": { "type": "string", "enum": ["resolved", "unresolved", "deferred"] },
        "rationale": { "type": "string" }
      },
      "required": ["conflict_id", "description", "resolution"],
      "additionalProperties": false
    },
    "InputField": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true },
        "sensitive": { "type": "boolean", "default": false },
        "schema": { "type": "object" }
      },
      "required": ["name", "schema"],
      "additionalProperties": false
    },
    "InputRequest": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "message": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/InputField" }, "minItems": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["request_id", "message", "fields"],
      "additionalProperties": false
    },
    "Filter": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "op": { "type": "string", "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "not_in", "contains", "starts_with", "is_null"] },
        "value": true
      },
      "required": ["field", "op"],
      "additionalProperties": false
    },
    "Aggregation": {
      "type": "object",
      "properties": {
        "measure": { "type": "string" },
        "function": { "type": "string", "enum": ["count", "count_distinct", "sum", "avg", "min", "max"] },
        "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      },
      "required": ["measure", "function", "as"],
      "additionalProperties": false
    },
    "QueryPlan": {
      "type": "object",
      "properties": {
        "schema_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "domains": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "select": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/Filter" } },
        "group_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "aggregations": { "type": "array", "items": { "$ref": "#/$defs/Aggregation" } },
        "order_by": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "field": { "type": "string" }, "direction": { "type": "string", "enum": ["asc", "desc"] } },
            "required": ["field", "direction"],
            "additionalProperties": false
          }
        },
        "limit": { "type": "integer", "minimum": 1 },
        "consistency": { "type": "string", "enum": ["best_effort", "snapshot", "source_native"] },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "required": ["schema_versions", "domains"],
      "anyOf": [{ "required": ["select"] }, { "required": ["aggregations"] }],
      "additionalProperties": false
    },
    "ResponseTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "schema_ref" }, "schema_id": { "type": "string", "format": "uri" } },
          "required": ["kind", "schema_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "inline" }, "schema": { "type": "object" } },
          "required": ["kind", "schema"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "derive" } },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "Routing": {
      "type": "object",
      "properties": {
        "reuse": { "type": "string", "enum": ["new", "reused", "replanned", "recomputed_for_authorization"] },
        "domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "plan_digest": { "type": "string" },
        "safe_rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_method": { "type": "string" }
      },
      "required": ["reuse", "domains", "plan_digest"],
      "dependentRequired": { "confidence": ["confidence_method"] },
      "additionalProperties": false
    },
    "Precondition": {
      "type": "object",
      "properties": {
        "resource": { "type": "string" },
        "kind": { "type": "string", "enum": ["version", "exists", "not_exists", "field_equals"] },
        "field": { "type": "string" },
        "expected": true
      },
      "required": ["resource", "kind"],
      "additionalProperties": false
    },
    "OperationSummary": {
      "type": "object",
      "properties": {
        "operation_id": { "type": "string" },
        "operation_version": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "input_schema_id": { "type": "string", "format": "uri" },
        "input_schema": { "type": "object" },
        "required_scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "risk": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "effect_class": { "type": "string", "enum": ["read", "create", "update", "delete", "send", "financial", "execute", "other"] },
        "approval": { "type": "string", "enum": ["never", "policy", "always"] },
        "idempotency": { "type": "string", "enum": ["required", "supported", "unsafe"] },
        "reversible": { "type": "boolean" },
        "compensation_operation_id": { "type": "string" }
      },
      "required": ["operation_id", "operation_version", "title", "input_schema_id", "input_schema", "risk", "effect_class", "approval", "idempotency", "reversible"],
      "additionalProperties": false
    },
    "ActionEffect": {
      "type": "object",
      "properties": {
        "effect_id": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "applied", "failed", "compensated", "compensation_failed"] },
        "kind": { "type": "string", "enum": ["created", "updated", "deleted", "sent", "financial", "executed", "other"] },
        "resource": { "type": "string" },
        "source_system": { "type": "string" },
        "entity_id": { "type": "string" },
        "reversible": { "type": "boolean" },
        "before": true,
        "after": true,
        "safe_detail": { "type": "string" },
        "error": { "$ref": "https://mcp-a.dev/schemas/2.0/error.json" }
      },
      "required": ["effect_id", "status", "kind", "resource", "source_system", "reversible"],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["failed", "compensation_failed"] } },
            "required": ["status"]
          },
          "then": { "required": ["error"] },
          "else": { "not": { "required": ["error"] } }
        }
      ],
      "additionalProperties": false
    }
  }
}
