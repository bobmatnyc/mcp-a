{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/query.response.json",
  "title": "mcpa.query and mcpa.follow_up Response",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["completed", "partial", "input_required"] },
    "query_id": { "type": "string" },
    "input_request": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/InputRequest" },
    "answer_id": { "type": "string" },
    "parent_answer_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "answer": { "type": "string" },
    "structured": true,
    "output_schema_id": { "type": "string", "format": "uri" },
    "output_schema": { "type": "object" },
    "executed_query_plan": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/QueryPlan" },
    "claims": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Claim" }, "minItems": 1, "maxItems": 10000 },
    "citations": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Citation" }, "minItems": 1, "maxItems": 10000 },
    "conflicts": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Conflict" }, "maxItems": 1000 },
    "completeness": { "type": "string", "enum": ["complete", "partial", "unknown"] },
    "computed_scope": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/ComputedScope" },
    "source_statuses": { "type": "array", "items": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/SourceStatus" }, "minItems": 1, "maxItems": 1000 },
    "routing": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Routing" },
    "created_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["status"],
  "oneOf": [
    {
      "title": "Completed answer",
      "properties": { "status": { "const": "completed" }, "completeness": { "const": "complete" } },
      "required": ["answer_id", "revision", "executed_query_plan", "claims", "citations", "conflicts", "completeness", "computed_scope", "source_statuses", "routing", "created_at", "as_of"],
      "anyOf": [{ "required": ["answer"] }, { "required": ["structured"] }],
      "not": { "anyOf": [{ "required": ["query_id"] }, { "required": ["input_request"] }] }
    },
    {
      "title": "Partial answer",
      "properties": { "status": { "const": "partial" }, "completeness": { "const": "partial" } },
      "required": ["answer_id", "revision", "executed_query_plan", "claims", "citations", "conflicts", "completeness", "computed_scope", "source_statuses", "routing", "created_at", "as_of"],
      "anyOf": [{ "required": ["answer"] }, { "required": ["structured"] }],
      "not": { "anyOf": [{ "required": ["query_id"] }, { "required": ["input_request"] }] }
    },
    {
      "title": "Input required",
      "properties": { "status": { "const": "input_required" } },
      "required": ["query_id", "input_request"],
      "not": {
        "anyOf": [
          { "required": ["answer_id"] }, { "required": ["answer"] }, { "required": ["structured"] },
          { "required": ["output_schema_id"] }, { "required": ["output_schema"] }, { "required": ["completeness"] },
          { "required": ["source_statuses"] }, { "required": ["routing"] }
        ]
      }
    }
  ],
  "dependentRequired": {
    "structured": ["output_schema_id", "output_schema"],
    "output_schema_id": ["structured", "output_schema"],
    "output_schema": ["structured", "output_schema_id"]
  },
  "additionalProperties": false
}
