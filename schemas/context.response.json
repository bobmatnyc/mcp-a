{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-a.dev/schemas/2.0/context.response.json",
  "title": "mcpa.context Response",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "enum": ["read", "set", "append", "clear"] },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": { "type": "string" },
          "version": { "type": "integer", "minimum": 0 },
          "values": { "type": "object", "additionalProperties": true },
          "max_bytes": { "type": "integer", "minimum": 0 },
          "used_bytes": { "type": "integer", "minimum": 0 },
          "expires_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["namespace", "version", "values", "max_bytes", "used_bytes", "updated_at"],
        "additionalProperties": false
      }
    },
    "updated_namespace": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "as_of": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "https://mcp-a.dev/schemas/2.0/common.defs.json#/$defs/Extensions" }
  },
  "required": ["mode", "as_of"],
  "oneOf": [
    { "properties": { "mode": { "const": "read" } }, "required": ["namespaces"], "not": { "anyOf": [{ "required": ["updated_namespace"] }, { "required": ["version"] }] } },
    { "properties": { "mode": { "enum": ["set", "append", "clear"] } }, "required": ["updated_namespace", "version"], "not": { "required": ["namespaces"] } }
  ],
  "additionalProperties": false
}
